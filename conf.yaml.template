server:
  port: 1983
  mode: "debug" # or "release"

bigquery:
  project_id: "your-gcp-project-id"
  credentials_path: "/path/to/service-account.json" # Optional

catalog:
  bundle_path: "okf-bundle"   # directory holding the OKF knowledge bundle (markdown)
  dataplex:
    project_id: ""            # defaults to bigquery.project_id when empty
    location: "global"        # Dataplex search location, e.g. "global" or "us"
  lineage_location: "us"      # Data Lineage API region (regional, not "global") — usually your BQ job region

# Crypto Pulse → Address Risk (all optional; defaults shown)
# address_risk:
#   db_path: "data/security.db"          # relative to the working directory
#   eth_rpc_urls:                         # keyless RPCs for the Chainalysis oracle, tried in order
#     - "https://ethereum-rpc.publicnode.com"
#     - "https://eth.drpc.org"
#   initial_sync_days: 30                 # first-start cold-start of ETH USDT/USDC freeze history (days, max 31; 0 = cold start off, ~$0.5 once)
#   etherscan_api_key: ""                 # optional, free: https://etherscan.io/myapikey — easier to set in the UI (Address Risk tab)
#   scam_radar:
#     initial_days: 30                    # Scam Radar & TRON freeze history (days, max 31; 0 = disable Scam Radar syncing, ~$0.55 once)
#     retention_days: 90                  # retention window for scam_lookalikes and scam_fake_tokens (days)
#     allow_zero_candidates: false        # escape hatch: true bypasses the per-day dust/zero-value candidate floor without disabling Scam Radar
#   bigquery_profile:                     # opt-in "BigQuery profile" switch on Ethereum lookups (off in the UI by default)
#     enabled: true                       # false = lookups never query BigQuery
#     max_bytes_billed: 2147483648        # per-lookup cap (2 GiB, max 10 GiB); typical ~0.9 GiB, busier addresses are rejected unbilled
#     max_per_hour: 60                    # global limit (token bucket, max 600); typical 60 x 0.9 GiB ≈ $0.33/h, cap ceiling 60 x 2 GiB = 120 GiB/h (≈ $0.73/h)
#     timeout_seconds: 20                 # lookup returns without the profile after this (max 45)

# Crypto Pulse → Payment Check (all optional; defaults shown)
# payment_check:
#   blockscout_urls:                      # set a chain to "" to disable Blockscout on it
#     eth: "https://eth.blockscout.com"
#     arb: "https://arbitrum.blockscout.com"
#     op: "https://explorer.optimism.io"
#     base: "https://base.blockscout.com"
#   logs_max_span: 10000                  # eth_getLogs max block span per chunk

# Crypto Pulse → RPC / Esplora endpoints (all optional; defaults shown)
# crypto_gas:
#   solana_rpc_urls:
#     - "https://solana-rpc.publicnode.com"
#     - "https://api.mainnet-beta.solana.com"
#   mempool_base_url: "https://mempool.space"

# Crypto Pulse → on-chain USD prices (optional; default shown). Daily ETH/USD and
# BTC/USD (WBTC-derived) are computed in BigQuery from Uniswap v3 swaps (median
# of the 00/06/12/18 UTC sampled hours) and stored in address_risk.db_path.
# crypto_prices:
#   initial_days: 365                     # first-start backfill (days, max 730; 0 = off; 365 ≈ 125 GiB ≈ $0.8 once, then ~360–500 MiB/day)

# Bitcoin dashboard (all optional; defaults shown). mempool.space URL: crypto_gas.mempool_base_url
# bitcoin:
#   enabled: true
#   providers:                          # keyless public APIs; false = never called
#     coinbase: true                    # spot price, daily candles, INTX perps, CDE (US) futures
#     kraken: true                      # spot price fallback and Kraken Futures
#     deribit: true                     # BTC-PERPETUAL, dated futures, DVOL
#     okx: true                         # BTC-USDT-SWAP ticker, OI, funding, rubik history
#     binance: true                     # auto: direct USD-M/COIN-M APIs, CoinGecko rows for 24 h after HTTP 451/403
#     hyperliquid: true                 # on-chain perps (metaAndAssetCtxs, fundingHistory)
#     coinmetrics: true                 # Community API, CC BY-NC 4.0 (non-commercial)
#     coingecko: true                   # spot tickers (+depth), derivatives stream, global dominance, public treasuries
#     cftc: true                        # CFTC Traders in Financial Futures (weekly CME & US-regulated BTC positioning)
#     blockchain_com: true              # price history 2010–2015 (Coin Metrics PriceUSD is the fallback)
#     # Added by subsequent M4–M5 tasks:
#     #   alternative_me (M4 Task 4.5)
#     #   bitnodes (≤ 4 snapshots/day), dbip (DB-IP Lite, CC BY 4.0, ≈ 11.5 MB/month in data/geo/) (M5)
#   bigquery:
#     jobs: false                       # OPERATOR OPT-IN. true = run Bitcoin BigQuery jobs billed to bigquery.project_id.
#                                       # The dashboard switch only shows/hides panels; it never starts jobs.
#     initial_days: 365                 # rollup cold start (7–730; 365 ≈ 88 GiB ≈ $0.54 once)
#     monthly_budget_gib: 2048          # ceiling for ALL Bitcoin BigQuery jobs incl. the UTXO baseline (≈ $12.50)
#     coin_age:
#       enabled: true
#       cadence_days: 7                 # 7–30; ≈ 102 GiB per run (weekly ≈ $2.75/month)
#       initial_days: 365               # 7–730; history backfill ≈ 157 GiB ≈ $0.96 once
#       whale_min_btc: 10
#       whales_per_day: 20
#     utxo_baseline:                    # ≈ 687 GiB ≈ $4.20 per run: ./biglens-server --bitcoin-utxo-baseline [--yes] [--force]
#       allow_ui: false                 # true = also allow dry run → confirm from the dashboard
#       min_interval_days: 30           # --force bypasses this, never the budget
# A job stopped by repeated billed failures (Job A: 4 within 24 h; Job B: 2 in a row) resumes with:
#   ./biglens-server --bitcoin-bq-resume <btc_onchain|btc_coinage>

